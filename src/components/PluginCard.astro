---
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils';

interface Props {
  plugin: CollectionEntry<'plugins'>;
}

const { plugin } = Astro.props;
const { title, tagline, version, platforms, mcVersions, accent, icon, tags } = plugin.data;
---

<a
  class="card pixel-box"
  href={url(`plugins/${plugin.id}`)}
  style={`--accent: ${accent}`}
  data-platforms={platforms.join('|')}
>
  <div class="icon" aria-hidden="true">
    {icon ? <img src={url(icon)} alt="" width="56" height="56" /> : <span>{title.charAt(0)}</span>}
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p class="tagline">{tagline}</p>
    <div class="meta">
      {platforms.map((p) => <span class="tag platform">{p}</span>)}
      <span class="tag">MC {mcVersions}</span>
      <span class="tag">v{version}</span>
    </div>
    {tags.length > 0 && <div class="meta">{tags.map((t) => <span class="tag">#{t}</span>)}</div>}
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: 16px;
    padding: 20px;
    color: var(--text);
    border-top: 4px solid var(--accent);
    transition: transform 0.12s, background 0.15s;
  }
  .card:hover { text-decoration: none; transform: translateY(-4px); background: var(--surface-2); }
  .icon {
    flex: none;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--accent) 22%, var(--bg));
    box-shadow: inset 0 -4px 0 rgba(0, 0, 0, 0.35), inset 0 4px 0 rgba(255, 255, 255, 0.12);
    image-rendering: pixelated;
  }
  .icon span { font-family: var(--font-pixel); font-size: 2rem; color: var(--accent); }
  .icon img { width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  h3 { font-size: 1.3rem; }
  .tagline { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
